{
	"name": "@tasks-calendar-wrapper/obsidian-plugin",
	"version": "0.0.0",
	"private": true,
	"description": "The Obsidian plugin: entry point, view, settings and the timeline UI. Released from the repository root.",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"api-floor": "node scripts/api-floor.mjs",
		"test": "node scripts/test.mjs",
		"capture:golden": "node scripts/capture-golden.mjs",
		"bench:vault": "node scripts/bench-vault.mjs",
		"bench": "pnpm build && node scripts/bench.mjs",
		"screenshots": "pnpm build && node scripts/screenshots.mjs"
	},
	"license": "MIT",
	"dependencies": {
		"@tasks-calendar-wrapper/core": "workspace:*",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"underscore": "1.13.7"
	},
	"devDependencies": {
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@types/backbone": "1.4.23",
		"@types/node": "20.19.43",
		"@types/react": "18.3.27",
		"@types/react-dom": "18.3.7",
		"backbone": "1.6.1",
		"esbuild": "0.28.2",
		"jsdom": "29.1.1",
		"moment": "2.29.4",
		"obsidian": "1.14.4",
		"typescript": "6.0.3"
	}
}
