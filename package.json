{
	"name": "tasks-calendar-wrapper",
	"version": "0.3.7",
	"private": true,
	"description": "Shows the tasks in your vault on a timeline view, based on the Tasks Calendar and Tasks Timeline scripts.",
	"scripts": {
		"dev": "pnpm --filter @tasks-calendar-wrapper/obsidian-plugin dev",
		"build": "pnpm --filter @tasks-calendar-wrapper/obsidian-plugin build",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm -r test",
		"capture:golden": "pnpm --filter @tasks-calendar-wrapper/obsidian-plugin capture:golden",
		"preversion": "node version-bump.mjs check",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"eslint": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\"",
		"eslint:fix": "eslint --fix \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\""
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"eslint": "9.39.5",
		"globals": "16.5.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.2"
	},
	"packageManager": "pnpm@10.27.0+sha512.72d699da16b1179c14ba9e64dc71c9a40988cbdc65c264cb0e489db7de917f20dcf4d64d8723625f2969ba52d4b7e2a1170682d9ac2a5dcaeaab732b7e16f04a"
}
